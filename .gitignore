# Never commit patient data or secrets
data/
*.jpg
*.jpeg
*.png
*.mp4
*.pdf
!docs/**/*.png
.env
*key*
*secret*
__pycache__/
*.pyc
.venv/
venv/
.streamlit/secrets.toml
# Medical images and other data formats
*.dcm
*.dicom
*.heic
*.webp
*.bmp
*.tif
*.tiff
*.webm
*.mov
*.zip
*.xlsx
*.xls
*.csv
!tests/**/*.csv
!app/assets/*.png
